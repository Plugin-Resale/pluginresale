# Copy to .env.local and fill in (Supabase dashboard → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://pwseqxvdvrkejeayroan.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, never expose to the browser (Supabase dashboard → Project Settings → API → service_role).
# Used to look up another user's email address to send them a notification.
SUPABASE_SERVICE_ROLE_KEY=

# Resend dashboard → API keys. Same key used for the Supabase Auth SMTP settings.
RESEND_API_KEY=
